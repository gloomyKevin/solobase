{
  "name": "solobase",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "migrate:json": "node --env-file=.env.local ./node_modules/.bin/tsx scripts/migrate/from-json.ts",
    "enrich:all": "node --env-file=.env.local ./node_modules/.bin/tsx scripts/migrate/enrich-all.ts",
    "enrich:media": "node --env-file=.env.local ./node_modules/.bin/tsx scripts/agents/enrich-media.ts",
    "feed:json": "tsx scripts/build-feed.ts",
    "feed:db": "tsx scripts/build-feed.ts --from-db",
    "publish": "node --env-file=.env.local ./node_modules/.bin/tsx scripts/agents/publisher.ts",
    "digest": "node --env-file=.env.local ./node_modules/.bin/tsx scripts/agents/digest.ts",
    "pipeline:daily": "tsx scripts/pipeline/run.ts && npm run feed:db"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.88.0",
    "@libsql/client": "^0.17.2",
    "@resvg/resvg-js": "^2.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.7.0",
    "next": "16.2.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "satori": "^0.26.0",
    "shadcn": "^4.2.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
